msgstr "Examinar…"

msgid "安装"
msgstr "Instalar"

msgid "安装前会逐个校验 SHA-256；校验不通过不会改动任何文件，旧素材会带时间戳备份。"
msgstr "Se verifica el SHA-256 de cada archivo antes de instalar; si el paquete está dañado no se modifica nada y los recursos anteriores se respaldan con marca de tiempo."

msgid "失败帧库为空：任务失败时会自动保存识别帧"
msgstr "Aún no hay fotogramas fallidos: el fotograma de reconocimiento se guarda al fallar una tarea"

msgid "复测完成：{summary}"
msgstr "Reanálisis completado: {summary}"

msgid "复测失败：{error}"
msgstr "Error en el reanálisis: {error}"

msgid "已清空 {count} 个失败帧"
msgstr "Se vaciaron {count} fotogramas fallidos"

msgid "无法打开目录：{error}"
msgstr "No se puede abrir la carpeta: {error}"

msgid "安装失败：{error}"
msgstr "Error de instalación: {error}"

