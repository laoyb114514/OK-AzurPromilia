msgstr "Tarea desconocida"

msgid "选择素材包"
msgstr "Seleccionar paquete de recursos"

msgid "素材包文件 (*.zip)"
msgstr "Paquete de recursos (*.zip)"

msgid "自动化策略"
msgstr "Política de automatización"

msgid "超时、重试与失败自恢复策略"
msgstr "Tiempos de espera, reintentos y recuperación de fallos"

msgid "单步超时(秒)"
msgstr "Tiempo de espera por paso (s)"

msgid "重试间隔(秒)"
msgstr "Intervalo de reintento (s)"

msgid "动作后等待(秒)"
msgstr "Espera tras la acción (s)"

msgid "卡死检测阈值(秒)"
msgstr "Umbral de detección de bloqueo (s)"

msgid "低配模式"
msgstr "Modo para equipos de gama baja"

msgid "失败后自动返回主菜单"
msgstr "Volver al menú principal tras un fallo"

msgid "最大返回次数"
msgstr "Número máximo de pulsaciones de volver"

msgid "失败帧保留数量"
msgstr "Fotogramas fallidos a conservar"

msgid "单个等待/轮询步骤的默认超时；任务里显式传超时的位置不受影响"
msgstr "Tiempo de espera predeterminado de un paso de espera o sondeo; los puntos que indican uno explícito no se ven afectados"

msgid "动作验证失败后重试之间的间隔，0 表示不额外等待"
msgstr "Espera entre reintentos tras un fallo de verificación; 0 significa sin espera adicional"

msgid "动作成功后追加的稳定等待，0 表示不等待"
msgstr "Espera adicional de estabilización tras una acción correcta; 0 significa sin espera"

msgid "画面长时间不变（判定为可能卡死）的阈值，只记录警告不中止任务"
msgstr "Umbral de pantalla sin cambios (posible bloqueo); solo registra un aviso y nunca aborta la tarea"

msgid "低配机器：所有超时统一放宽 1.5 倍，卡死阈值同步放宽"
msgstr "Equipos de gama baja: todos los tiempos de espera se amplían 1,5 veces, incluido el umbral de bloqueo"

msgid "任务失败后自动按返回键退回主菜单，只退菜单不重跑任务"
msgstr "Tras un fallo, pulsa Atrás para volver al menú principal; nunca vuelve a ejecutar la tarea"

msgid "失败后最多按几次返回键"
msgstr "Número máximo de pulsaciones de Atrás tras un fallo"

msgid "失败帧库最多保留多少帧，超出后丢弃最旧的"
msgstr "Cuántos fotogramas fallidos se conservan; los más antiguos se descartan"
