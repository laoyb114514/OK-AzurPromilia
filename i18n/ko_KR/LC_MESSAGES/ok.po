msgstr "타임아웃, 재시도 및 실패 자동 복구"

msgid "单步超时(秒)"
msgstr "단계 타임아웃(초)"

msgid "重试间隔(秒)"
msgstr "재시도 간격(초)"

msgid "动作后等待(秒)"
msgstr "동작 후 대기(초)"

msgid "卡死检测阈值(秒)"
msgstr "멈춤 감지 임계값(초)"

msgid "低配模式"
msgstr "저사양 모드"

msgid "失败后自动返回主菜单"
msgstr "실패 후 자동으로 메인 메뉴로 돌아가기"

msgid "最大返回次数"
msgstr "최대 돌아가기 횟수"

msgid "失败帧保留数量"
msgstr "보관할 실패 프레임 수"

msgid "单个等待/轮询步骤的默认超时；任务里显式传超时的位置不受影响"
msgstr "단일 대기/폴링 단계의 기본 타임아웃입니다. 명시적으로 지정한 곳에는 영향을 주지 않습니다"

msgid "动作验证失败后重试之间的间隔，0 表示不额外等待"
msgstr "동작 검증 실패 후 재시도 사이의 간격입니다. 0이면 추가 대기가 없습니다"

msgid "动作成功后追加的稳定等待，0 表示不等待"
msgstr "동작 성공 후 추가 안정 대기입니다. 0이면 대기하지 않습니다"

msgid "画面长时间不变（判定为可能卡死）的阈值，只记录警告不中止任务"
msgstr "화면이 오랫동안 그대로일 때(멈춤 의심) 경고를 기록하는 임계값입니다. 경고만 남기고 작업은 중단하지 않습니다"

msgid "低配机器：所有超时统一放宽 1.5 倍，卡死阈值同步放宽"
msgstr "저사양 환경: 모든 타임아웃을 1.5배로 늘리고 멈춤 임계값도 함께 늘립니다"

msgid "任务失败后自动按返回键退回主菜单，只退菜单不重跑任务"
msgstr "작업 실패 후 뒤로 가기로 메인 메뉴로 돌아갑니다. 작업을 다시 실행하지는 않습니다"

msgid "失败后最多按几次返回键"
msgstr "실패 후 뒤로 가기를 누르는 최대 횟수"

msgid "失败帧库最多保留多少帧，超出后丢弃最旧的"
msgstr "보관할 실패 프레임의 최대 개수입니다. 초과하면 오래된 것부터 삭제됩니다"
