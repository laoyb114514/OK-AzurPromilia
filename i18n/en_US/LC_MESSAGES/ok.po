msgstr "Timeouts, retries and failure recovery"

msgid "单步超时(秒)"
msgstr "Step timeout (s)"

msgid "重试间隔(秒)"
msgstr "Retry interval (s)"

msgid "动作后等待(秒)"
msgstr "Wait after action (s)"

